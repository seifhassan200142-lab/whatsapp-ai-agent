# Never share the real .env file.
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
META_ACCESS_TOKEN=PASTE_META_TEMPORARY_ACCESS_TOKEN
META_PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID
META_APP_SECRET=PASTE_META_APP_SECRET
# python -m scripts.prepare_env creates these two random values for you:
META_VERIFY_TOKEN=PASTE_RANDOM_VERIFY_TOKEN_MIN_32_CHARS
ADMIN_API_KEY=PASTE_RANDOM_ADMIN_KEY_MIN_32_CHARS
META_GRAPH_VERSION=v26.0
DB_PATH=data/conversations.sqlite3
KNOWLEDGE_PATH=data/knowledge.md
HISTORY_MESSAGES=10
MAX_AUDIO_BYTES=16000000
GROQ_MIN_INTERVAL_SECONDS=3
GROQ_MAX_CALLS_PER_DAY=100
REQUEST_TIMEOUT=35
